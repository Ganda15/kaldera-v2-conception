<mxfile host="app.diagrams.net" type="device"><diagram id="schema-1-carte-des-agents" name="Carte des agents"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Carte des agents · Chantier 1" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="st" value="Rôles, frontières, point ambigu tranché, dépendances et parallélisme. Proposition provisoire, à confirmer avec specs_metier.md." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1100" height="22" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;Orchestrateur&lt;/b&gt; (code, sans LLM)&lt;br&gt;Délègue chaque étape, applique les bornes, écrit le statut final.&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; refaire un contrôle métier (éligibilité, pièces, montant, fraude).&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="95" width="640" height="78" as="geometry"/></mxCell><mxCell id="par" value="Exécutées en parallèle : aucune n&#x27;a besoin du résultat de l&#x27;autre" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3d85c6;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Arial;fontSize=11;fontColor=#3d85c6;" vertex="1" parent="1"><mxGeometry x="30" y="225" width="440" height="400" as="geometry"/></mxCell><mxCell id="elig" value="&lt;b&gt;Éligibilité&lt;/b&gt; (règles en code)&lt;br&gt;&lt;br&gt;Vérifie que le contrat couvre la demande.&lt;br&gt;Renvoie : éligible oui ou non, avec le motif.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; calculer un montant, juger les pièces, juger la fraude.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="260" width="400" height="150" as="geometry"/></mxCell><mxCell id="pieces" value="&lt;b&gt;Pièces justificatives&lt;/b&gt; (code, LLM pour lire le texte libre)&lt;br&gt;&lt;br&gt;Vérifie que les pièces exigées sont présentes et cohérentes.&lt;br&gt;Renvoie : complet oui ou non, pièces manquantes, incohérences constatées.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; conclure à la fraude ; il constate une incohérence, il ne la qualifie pas.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="435" width="400" height="170" as="geometry"/></mxCell><mxCell id="estim" value="&lt;b&gt;Estimation&lt;/b&gt; (règles en code)&lt;br&gt;&lt;br&gt;Calcule le montant à rembourser, plafond et franchise compris.&lt;br&gt;Renvoie : le montant et le détail du calcul.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; juger la fraude, revenir sur l&#x27;éligibilité.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="300" width="340" height="170" as="geometry"/></mxCell><mxCell id="fraude" value="&lt;b&gt;Fraude, liaison avec le partenaire&lt;/b&gt; (code)&lt;br&gt;&lt;br&gt;Tourne à chaque demande : décide s&#x27;il y a suspicion. Si oui seulement, interroge le partenaire et contrôle sa réponse.&lt;br&gt;Renvoie : pas de suspicion, verdict validé, réponse rejetée ou partenaire indisponible.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;Interdit :&lt;/b&gt; rendre lui-même un verdict de fraude, envoyer une donnée hors contrat.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="950" y="280" width="380" height="210" as="geometry"/></mxCell><mxCell id="partenaire" value="&lt;b&gt;Partenaire anti-fraude&lt;/b&gt; (agent A2A externe)&lt;br&gt;Contrat, filtre des données et mode dégradé : chantier 2" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1000" y="610" width="300" height="70" as="geometry"/></mxCell><mxCell id="ambig" value="&lt;b&gt;Point ambigu tranché : qui déclare une suspicion de fraude ?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Seul l&#x27;agent Fraude. Pièces et Estimation lui transmettent des faits (une incohérence, un montant), jamais le mot « fraude ». Le partenaire rend le verdict ; l&#x27;agent Fraude décide seulement s&#x27;il faut le demander.&lt;br&gt;&lt;br&gt;&lt;i&gt;Raison : le brief interdit déjà à l&#x27;estimation de juger la fraude ; un seul propriétaire donne une seule liste de critères à tester et une seule porte vers le partenaire.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="560" width="440" height="190" as="geometry"/></mxCell><mxCell id="autres" value="&lt;b&gt;Deux autres frontières tranchées&lt;/b&gt;&lt;br&gt;• Plafond du contrat : Estimation, car il fait partie du calcul du montant.&lt;br&gt;• Pièces manquantes : constatées par Pièces ; le statut est décidé par l&#x27;orchestrateur, avec sa table de décision." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="660" width="440" height="100" as="geometry"/></mxCell><mxCell id="d1" value="délègue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.08;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="elig"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="451" y="200"/><mxPoint x="410" y="200"/></Array></mxGeometry></mxCell><mxCell id="d2" value="délègue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="estim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3" value="délègue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="fraude"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="230"/><mxPoint x="1140" y="230"/></Array></mxGeometry></mxCell><mxCell id="p1" value="éligible = oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="elig" target="estim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2" value="pièces complètes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.38;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="pieces" target="estim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="495" y="500"/><mxPoint x="495" y="420"/></Array></mxGeometry></mxCell><mxCell id="p3" value="montant (un fait)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="estim" target="fraude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f1" value="incohérences constatées (des faits)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;dashPattern=3 3;strokeColor=#e69138;strokeWidth=1.5;fontColor=#b45f06;exitX=1;exitY=0.89;exitDx=0;exitDy=0;entryX=0.13;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pieces" target="fraude"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="590"/><mxPoint x="480" y="530"/><mxPoint x="1000" y="530"/></Array></mxGeometry></mxCell><mxCell id="x1" value="seulement si suspicion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0.45;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fraude" target="partenaire"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x2" value="verdict à valider" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0.83;exitY=0;exitDx=0;exitDy=0;entryX=0.79;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="partenaire" target="fraude"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="560"/></Array></mxGeometry></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Code (orchestration)" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="154" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#3d85c6&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Agent spécialiste" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="194" y="800" width="135" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Point ambigu tranché" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="339" y="800" width="154" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#cc0000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Frontière : interdit" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="503" y="800" width="154" height="26" as="geometry"/></mxCell><mxCell id="leg4" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Externe ou chantier 2" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="667" y="800" width="160" height="26" as="geometry"/></mxCell><mxCell id="lg2" value="Trait plein : dépendance de données · pointillé vert : délégation · pointillé orange : fait transmis à Fraude" style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="836" width="900" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>