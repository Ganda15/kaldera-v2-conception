<mxfile host="app.diagrams.net" type="device"><diagram id="schema-3-memoire-partagee" name="Mémoire partagée"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="810" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Mémoire partagée de la demande · Chantier 1" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="st" value="Un état par demande. Seul son propriétaire écrit une section métier ; la trace enregistre qui a écrit quoi à chaque étape (interface.md)." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1200" height="22" as="geometry"/></mxCell><mxCell id="agents" value="Agents : chacun écrit sa section, lit seulement ce dont il a besoin" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3d85c6;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Arial;fontSize=11;fontColor=#3d85c6;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="400" height="640" as="geometry"/></mxCell><mxCell id="ae" value="&lt;b&gt;Éligibilité&lt;/b&gt;&lt;br&gt;lit : demande (contrat, sinistre)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="210" width="360" height="56" as="geometry"/></mxCell><mxCell id="ap" value="&lt;b&gt;Pièces&lt;/b&gt;&lt;br&gt;lit : demande (pièces, espace assuré)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="282" width="360" height="56" as="geometry"/></mxCell><mxCell id="aes" value="&lt;b&gt;Estimation&lt;/b&gt;&lt;br&gt;lit : demande, pieces (factures lisibles)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="354" width="360" height="56" as="geometry"/></mxCell><mxCell id="af" value="&lt;b&gt;Anti-fraude&lt;/b&gt;&lt;br&gt;lit : demande, estimation (montant justifié)&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;ne lit pas : pieces (contenu des pièces)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="426" width="360" height="64" as="geometry"/></mxCell><mxCell id="ac" value="&lt;b&gt;Coordination&lt;/b&gt;&lt;br&gt;lit : toutes les sections · écrit : issue, controle, trace" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="506" width="360" height="56" as="geometry"/></mxCell><mxCell id="etat" value="État de la demande · reference (KAL-AA-NNNN)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="600" height="640" as="geometry"/></mxCell><mxCell id="demande" value="&lt;b&gt;demande&lt;/b&gt; : la demande reçue (§ 3)&lt;br&gt;écrite à la création, puis en lecture seule" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="138" width="560" height="56" as="geometry"/></mxCell><mxCell id="eligibilite" value="&lt;b&gt;eligibilite&lt;/b&gt; · écrite par Éligibilité&lt;br&gt;éligible, conditions non remplies" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="210" width="560" height="56" as="geometry"/></mxCell><mxCell id="pieces" value="&lt;b&gt;pieces&lt;/b&gt; · écrite par Pièces&lt;br&gt;complet ou manquantes, factures lisibles, compléments demandés" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="282" width="560" height="56" as="geometry"/></mxCell><mxCell id="estimation" value="&lt;b&gt;estimation&lt;/b&gt; · écrite par Estimation&lt;br&gt;montant justifié, montant estimé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="354" width="560" height="56" as="geometry"/></mxCell><mxCell id="avis_fraude" value="&lt;b&gt;avis_fraude&lt;/b&gt; · écrite par Anti-fraude&lt;br&gt;non requis, avis (niveau, score, evaluation_id) ou indisponible" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="426" width="560" height="56" as="geometry"/></mxCell><mxCell id="issue" value="&lt;b&gt;issue&lt;/b&gt; · écrite par la Coordination, conclut la demande&lt;br&gt;décision ou escalade, montant, motif, file, mode dégradé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#d9ead3;strokeColor=#2E6B3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="506" width="560" height="56" as="geometry"/></mxCell><mxCell id="controle" value="&lt;b&gt;controle&lt;/b&gt; (hors métier) : compteurs des bornes, marqueur d&#x27;appel au partenaire, arret" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#d9ead3;strokeColor=#2E6B3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="584" width="560" height="44" as="geometry"/></mxCell><mxCell id="trace" value="&lt;b&gt;trace&lt;/b&gt; (hors métier), ajout seul : une étape par ligne&lt;br&gt;agent, sections écrites, action, durée, statut" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#d9ead3;strokeColor=#2E6B3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="648" width="560" height="56" as="geometry"/></mxCell><mxCell id="wae" value="écrit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ae" target="eligibilite"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wap" value="écrit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ap" target="pieces"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="waes" value="écrit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aes" target="estimation"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="waf" value="écrit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="af" target="avis_fraude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wac" value="écrit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ac" target="issue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="garde" value="&lt;b&gt;Comment un agent n&#x27;écrase pas le travail d&#x27;un autre&lt;/b&gt;&lt;br&gt;• Une table fixe propriétaire de chaque section ; écrire dans une autre section est refusé (erreur de droits).&lt;br&gt;• pieces est réécrite par Pièces après chaque dépôt de l&#x27;assuré ; les autres sections métier ne sont écrites qu&#x27;une fois.&lt;br&gt;• Éligibilité et Pièces tournent en parallèle sans conflit : sections différentes.&lt;br&gt;• La trace note l&#x27;agent et les sections écrites à chaque étape : la règle se vérifie par un test." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1130" y="100" width="400" height="190" as="geometry"/></mxCell><mxCell id="vit" value="&lt;b&gt;Où vit-elle ?&lt;/b&gt;&lt;br&gt;En mémoire, un objet par demande, créé au début du traitement. Jamais partagé entre deux demandes : le traitement d&#x27;une demande n&#x27;en retarde pas une autre (§ 12). À la fin, la fiche de décision est construite depuis issue, avis_fraude, trace et arret." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="310" width="400" height="140" as="geometry"/></mxCell><mxCell id="part" value="&lt;b&gt;Partenaire anti-fraude&lt;/b&gt;&lt;br&gt;reçoit seulement les 7 champs du contrat, construits par Anti-fraude (chantier 2)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1130" y="470" width="400" height="70" as="geometry"/></mxCell><mxCell id="metr" value="&lt;b&gt;Métriques par agent&lt;/b&gt; (chantier 2)&lt;br&gt;calculées depuis la trace : appels, échecs, latence, appels externes" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1130" y="620" width="400" height="70" as="geometry"/></mxCell><mxCell id="m1" value="filtre" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="avis_fraude" target="part"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="trace" target="metr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Coordination" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="770" width="103" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#3d85c6&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Section d&#x27;un agent" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="143" y="770" width="141" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Règle d&#x27;écriture" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="294" y="770" width="128" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#cc0000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Lecture interdite" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="432" y="770" width="135" height="26" as="geometry"/></mxCell><mxCell id="leg4" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Externe ou chantier 2" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="577" y="770" width="160" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>