<mxfile host="app.diagrams.net" type="device"><diagram id="schema-3-memoire-partagee" name="Mémoire partagée"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1490" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Mémoire partagée de la demande · Chantier 1" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="st" value="Un état par demande, sauvegardé après chaque étape. Chaque section a un seul propriétaire, et l&#x27;orchestrateur est le seul à écrire." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1100" height="22" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;Orchestrateur : le seul à écrire&lt;/b&gt;&lt;br&gt;1. reçoit le résultat d&#x27;un agent · 2. le valide contre le schéma de sortie de cet agent · 3. l&#x27;écrit dans la section de cet agent, et nulle part ailleurs · 4. ajoute l&#x27;événement au journal · 5. sauvegarde l&#x27;état" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="92" width="640" height="78" as="geometry"/></mxCell><mxCell id="agents" value="Agents spécialistes : lecture seule, sections utiles seulement" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3d85c6;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Arial;fontSize=11;fontColor=#3d85c6;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="350" height="560" as="geometry"/></mxCell><mxCell id="ae" value="&lt;b&gt;Éligibilité&lt;/b&gt;&lt;br&gt;lit : demande" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="270" width="310" height="60" as="geometry"/></mxCell><mxCell id="ap" value="&lt;b&gt;Pièces justificatives&lt;/b&gt;&lt;br&gt;lit : demande" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="350" width="310" height="60" as="geometry"/></mxCell><mxCell id="aes" value="&lt;b&gt;Estimation&lt;/b&gt;&lt;br&gt;lit : demande, eligibilite, pieces&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;ne lit pas : fraude&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="430" width="310" height="80" as="geometry"/></mxCell><mxCell id="af" value="&lt;b&gt;Fraude&lt;/b&gt;&lt;br&gt;lit : demande, pieces (incohérences), estimation (montant)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="310" height="70" as="geometry"/></mxCell><mxCell id="apar" value="Éligibilité et Pièces tournent en parallèle sans conflit : chacune a sa section, et un seul écrivain." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="620" width="310" height="70" as="geometry"/></mxCell><mxCell id="etat" value="État de la demande · claim_id" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="430" y="230" width="640" height="560" as="geometry"/></mxCell><mxCell id="demande" value="&lt;b&gt;demande&lt;/b&gt; : données reçues&lt;br&gt;écrite à la création, puis en lecture seule · lue par : tous les agents" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="450" y="270" width="600" height="60" as="geometry"/></mxCell><mxCell id="eligibilite" value="&lt;b&gt;eligibilite&lt;/b&gt;&lt;br&gt;propriétaire : Éligibilité · lue par : orchestrateur, Estimation" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#cfe2f3;strokeColor=#3d85c6;" vertex="1" parent="1"><mxGeometry x="450" y="342" width="600" height="60" as="geometry"/></mxCell><mxCell id="pieces" value="&lt;b&gt;pieces&lt;/b&gt;&lt;br&gt;propriétaire : Pièces · lue par : orchestrateur, Estimation, Fraude" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#cfe2f3;strokeColor=#3d85c6;" vertex="1" parent="1"><mxGeometry x="450" y="414" width="600" height="60" as="geometry"/></mxCell><mxCell id="estimation" value="&lt;b&gt;estimation&lt;/b&gt;&lt;br&gt;propriétaire : Estimation · lue par : orchestrateur, Fraude" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#cfe2f3;strokeColor=#3d85c6;" vertex="1" parent="1"><mxGeometry x="450" y="486" width="600" height="60" as="geometry"/></mxCell><mxCell id="fraude" value="&lt;b&gt;fraude&lt;/b&gt; : suspicion, verdict validé, taskId et contextId A2A&lt;br&gt;propriétaire : Fraude · lue par : orchestrateur seulement" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#cfe2f3;strokeColor=#3d85c6;" vertex="1" parent="1"><mxGeometry x="450" y="558" width="600" height="60" as="geometry"/></mxCell><mxCell id="controle" value="&lt;b&gt;controle&lt;/b&gt; : étape en cours, compteurs des bornes, statut final, motif d&#x27;escalade&lt;br&gt;propriétaire : orchestrateur · lue par : orchestrateur, humain en cas d&#x27;escalade" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#d9ead3;strokeColor=#2E6B3E;" vertex="1" parent="1"><mxGeometry x="450" y="630" width="600" height="60" as="geometry"/></mxCell><mxCell id="journal" value="&lt;b&gt;journal&lt;/b&gt; : un événement par étape (qui, quoi, quand, durée, résultat), ajout seul&lt;br&gt;source des métriques par agent (latence, échecs, recours à l&#x27;externe)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=0;fillColor=#d9ead3;strokeColor=#2E6B3E;" vertex="1" parent="1"><mxGeometry x="450" y="702" width="600" height="60" as="geometry"/></mxCell><mxCell id="sauve" value="&lt;b&gt;Sauvegarde après chaque étape&lt;/b&gt;&lt;br&gt;reprise après un crash, sans demande oubliée" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1140" y="270" width="320" height="110" as="geometry"/></mxCell><mxCell id="front" value="&lt;b&gt;La frontière passe aussi par les données&lt;/b&gt;&lt;br&gt;Un agent n&#x27;écrit jamais lui-même. L&#x27;Estimation ne voit pas la section fraude, donc elle ne peut pas s&#x27;en servir." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1140" y="410" width="340" height="84" as="geometry"/></mxCell><mxCell id="part" value="&lt;b&gt;Partenaire anti-fraude&lt;/b&gt;&lt;br&gt;reçoit seulement les champs du contrat, construits par le filtre (chantier 2)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1140" y="548" width="320" height="80" as="geometry"/></mxCell><mxCell id="metr" value="&lt;b&gt;Monitorage par agent&lt;/b&gt; (chantier 2)&lt;br&gt;calculé à partir du journal" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1140" y="702" width="320" height="60" as="geometry"/></mxCell><mxCell id="m1" value="renvoie son résultat, jamais d&#x27;écriture directe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agents" target="orch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="131"/></Array></mxGeometry></mxCell><mxCell id="m2" value="écrit, après validation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="etat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m3" value="lit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;strokeWidth=2;exitX=0;exitY=0.482;exitDx=0;exitDy=0;entryX=1;entryY=0.482;entryDx=0;entryDy=0;" edge="1" parent="1" source="etat" target="agents"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m4" value="sauvegarde" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6aa84f;strokeWidth=1.5;fontColor=#38761d;exitX=1;exitY=0.125;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="etat" target="sauve"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m5" value="filtre" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fraude" target="part"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="journal" target="metr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Orchestrateur, seul écrivain" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="820" width="205" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#3d85c6&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Section d&#x27;un agent" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="245" y="820" width="141" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Frontière par les données" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="396" y="820" width="186" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#cc0000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Lecture interdite" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="592" y="820" width="135" height="26" as="geometry"/></mxCell><mxCell id="leg4" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Externe ou chantier 2" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="737" y="820" width="160" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>