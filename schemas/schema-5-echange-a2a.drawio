<mxfile host="app.diagrams.net" type="device"><diagram id="schema-5-echange-a2a" name="Échange A2A et mode dégradé"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Échange A2A, filtre, validation et mode dégradé · Chantier 2" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="st" value="Un seul point de sortie vers le partenaire : rien ne sort hors contrat, rien n&#x27;entre sans validation. Proposition provisoire, à confirmer avec le contrat du partenaire et specs_metier.md." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1450" height="22" as="geometry"/></mxCell><mxCell id="kaldera" value="Système Kaldera" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="1070" height="880" as="geometry"/></mxCell><mxCell id="externe" value="Partenaire anti-fraude (externe)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#333333;fillColor=#f7f7f7;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1120" y="95" width="390" height="880" as="geometry"/></mxCell><mxCell id="mem" value="&lt;b&gt;Mémoire partagée&lt;/b&gt;&lt;br&gt;section fraude : suspicion, taskId, contextId, verdict validé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="260" height="80" as="geometry"/></mxCell><mxCell id="fraude" value="&lt;b&gt;Agent Fraude&lt;/b&gt;&lt;br&gt;suspicion déclarée : il faut interroger le partenaire" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="280" height="80" as="geometry"/></mxCell><mxCell id="filtre" value="&lt;b&gt;Filtre sortant (E3)&lt;/b&gt;&lt;br&gt;message neuf, construit champ par champ depuis la liste blanche du contrat ; validé contre le schéma, aucun champ en plus ; en cas d&#x27;échec, rien ne part" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="245" width="280" height="125" as="geometry"/></mxCell><mxCell id="envoi" value="&lt;b&gt;Envoi sans attendre la fin de la tâche&lt;/b&gt;&lt;br&gt;taskId et contextId enregistrés aussitôt dans la mémoire" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="260" width="290" height="90" as="geometry"/></mxCell><mxCell id="lecture" value="&lt;b&gt;Lecture de l&#x27;état de la tâche&lt;/b&gt;&lt;br&gt;jusqu&#x27;au délai maximum, au rythme permis par le contrat" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="395" width="290" height="70" as="geometry"/></mxCell><mxCell id="d1" value="Tâche terminée&lt;br&gt;avant le délai ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="505" width="200" height="100" as="geometry"/></mxCell><mxCell id="valid" value="&lt;b&gt;Validation de la réponse (E4)&lt;/b&gt;&lt;br&gt;• protocole : JSON-RPC valide, même id, réponse de type Task ou Message&lt;br&gt;• schéma : partie données conforme au contrat, aucun champ en plus&lt;br&gt;• sens : même claim_ref, score dans ses bornes, verdict cohérent&lt;br&gt;Toute réponse non conforme est rejetée, jamais propagée." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="625" width="380" height="140" as="geometry"/></mxCell><mxCell id="d2" value="Réponse&lt;br&gt;conforme ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="790" width="200" height="90" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;Verdict écrit dans la mémoire&lt;/b&gt;&lt;br&gt;la demande continue vers la table de décision (chantier 1)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="805" width="260" height="70" as="geometry"/></mxCell><mxCell id="deg" value="&lt;b&gt;Mode dégradé (E5)&lt;/b&gt;, défini par specs_metier.md&lt;br&gt;la demande continue (table de décision) ou elle est routée (escalade humaine motivée)" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="785" width="280" height="100" as="geometry"/></mxCell><mxCell id="tardive" value="Réponse arrivée après le passage en mode dégradé : journalisée, sans changer la décision prise." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="900" width="280" height="55" as="geometry"/></mxCell><mxCell id="journal" value="&lt;b&gt;Journal d&#x27;événements&lt;/b&gt;&lt;br&gt;message envoyé après filtre, réponse reçue, résultat de la validation, durée ; aucune donnée hors contrat" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="260" height="130" as="geometry"/></mxCell><mxCell id="contrat" value="&lt;b&gt;Contrat d&#x27;échange&lt;/b&gt; (fourni par le partenaire)&lt;br&gt;champs autorisés · format · délai par appel · rythme de lecture de l&#x27;état · règles de relance · version&lt;br&gt;&lt;i&gt;Il fixe le filtre, les relances et la validation.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="130" width="350" height="105" as="geometry"/></mxCell><mxCell id="partenaire" value="&lt;b&gt;Partenaire anti-fraude&lt;/b&gt;&lt;br&gt;Agent Card · tâche A2A · verdict" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1140" y="260" width="350" height="90" as="geometry"/></mxCell><mxCell id="x1" value="lit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.43;exitDx=0;exitDy=0;entryX=0;entryY=0.43;entryDx=0;entryDy=0;" edge="1" parent="1" source="mem" target="fraude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fraude" target="filtre"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x3" value="message filtré" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.44;exitDx=0;exitDy=0;entryX=0;entryY=0.44;entryDx=0;entryDy=0;" edge="1" parent="1" source="filtre" target="envoi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x4" value="champs du contrat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.44;exitDx=0;exitDy=0;entryX=0;entryY=0.44;entryDx=0;entryDy=0;" edge="1" parent="1" source="envoi" target="partenaire"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.552;exitY=1;exitDx=0;exitDy=0;entryX=0.552;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="envoi" target="lecture"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x6" value="état de la tâche" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="partenaire" target="lecture"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="430"/></Array></mxGeometry></mxCell><mxCell id="x7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.552;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lecture" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x8" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="valid"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="555"/></Array></mxGeometry></mxCell><mxCell id="x9" value="non : délai dépassé · annulation de la tâche" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="deg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="valid" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x11" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6aa84f;strokeWidth=1.5;fontColor=#38761d;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.43;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x12" value="non : rejet journalisé" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="deg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x13" value="erreur réseau, panne, accès refusé : relances bornées par le contrat, puis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#bf9000;strokeWidth=1.5;fontColor=#7f6000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="partenaire" target="deg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1315" y="835"/></Array></mxGeometry></mxCell><mxCell id="x14" value="trace" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;strokeWidth=1.2;fontColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="valid" target="journal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="695"/></Array></mxGeometry></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#2E6B3E&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Contrôle écrit en code" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="1000" width="167" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#3d85c6&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Agent" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="207" y="1000" width="58" height="26" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Partenaire externe" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="275" y="1000" width="141" height="26" as="geometry"/></mxCell><mxCell id="leg3" value="&lt;font color=&quot;#6aa84f&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Verdict accepté" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="426" y="1000" width="122" height="26" as="geometry"/></mxCell><mxCell id="leg4" value="&lt;font color=&quot;#bf9000&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Chemin de repli" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="558" y="1000" width="122" height="26" as="geometry"/></mxCell><mxCell id="leg5" value="&lt;font color=&quot;#e69138&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Selon specs_metier.md" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="690" y="1000" width="160" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>