<mxfile host="app.diagrams.net" type="device"><diagram id="schema-6-plan-epreuve" name="Plan d&#x27;épreuve"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="796" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Plan d&#x27;épreuve : scénarios × signaux × ajustements · Chantier 2" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="st" value="Chaque scénario est rejoué, ses signaux comparés au critère attendu ; tout écart provoque un ajustement du chantier 1, consigné, puis un nouveau rejeu. Valeurs et seuils provisoires." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1350" height="22" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;1. Rejouer&lt;/b&gt; un scénario&lt;br&gt;eval/scenarios.jsonl, partenaire simulé par un bouchon réglable" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="240" height="85" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;2. Observer&lt;/b&gt; les signaux&lt;br&gt;statut final, étapes, latence, rejets, mode dégradé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="340" y="105" width="240" height="85" as="geometry"/></mxCell><mxC