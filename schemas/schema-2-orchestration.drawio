<mxfile host="app.diagrams.net" type="device"><diagram id="schema-2-orchestration" name="Orchestration et terminaison"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1510" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Kaldera V2 · Orchestration et terminaison garantie · Chantier 1" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#2E6B3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="st" value="Délégations, conditions d&#x27;arrêt et bornes provisoires. Chaque chemin finit par une décision ou par une escalade humaine motivée." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1100" height="22" as="geometry"/></mxCell><mxCell id="deleg" value="Chaque flèche est une transition décidée par l&#x27;orchestrateur (code). Les agents ne s&#x27;appellent jamais entre eux. L&#x27;état est sauvegardé après chaque étape." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="440" height="60" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;Demande reçue&lt;/b&gt;&lt;br&gt;état créé et sauvegardé" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="170" y="95" width="320" height="52" as="geometry"/></mxCell><mxCell id="par" value="En parallèle" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3d85c6;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Arial;fontSize=11;fontColor=#3d85c6;" vertex="1" parent="1"><mxGeometry x="40" y="182" width="580" height="110" as="geometry"/></mxCell><mxCell id="e" value="&lt;b&gt;Éligibilité&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="60" y="215" width="250" height="55" as="geometry"/></mxCell><mxCell id="p" value="&lt;b&gt;Pièces justificatives&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="350" y="215" width="250" height="55" as="geometry"/></mxCell><mxCell id="d1" value="Refus bloquant ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="230" y="325" width="200" height="100" as="geometry"/></mxCell><mxCell id="crit" value="Refus bloquant : non éligible, ou pièces manquantes si specs_metier.md le prévoit (à confirmer)." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="330" height="60" as="geometry"/></mxCell><mxCell id="est" value="&lt;b&gt;Estimation&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#cfe2f3;strokeColor=#3d85c6;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="180" y="475" width="300" height="55" as="geometry"/></mxCell><mxCell id="d2" value="Agent Fraude :&lt;br&gt;suspicion ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="230" y="570" width="200" height="100" as="geometry"/></mxCell><mxCell id="part" value="&lt;b&gt;Appel au partenaire A2A&lt;/b&gt;&lt;br&gt;chantier 2" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="560" y="590" width="280" height="60" as="geometry"/></mxCell><mxCell id="deg" value="&lt;b&gt;Mode dégradé&lt;/b&gt; défini par specs_metier.md&lt;br&gt;chantier 2" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="560" y="715" width="280" height="60" as="geometry"/></mxCell><mxCell id="tab" value="&lt;b&gt;Table de décision&lt;/b&gt;&lt;br&gt;orchestrateur, code" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#d9ead3;strokeColor=#2E6B3E;strokeWidth=2;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="180" y="800" width="300" height="60" as="geometry"/></mxCell><mxCell id="acc" value="&lt;b&gt;DÉCISION : ACCEPTÉE&lt;/b&gt;&lt;br&gt;montant fixé par l&#x27;Estimation" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="260" height="64" as="geometry"/></mxCell><mxCell id="ref" value="&lt;b&gt;DÉCISION : REFUSÉE&lt;/b&gt;&lt;br&gt;avec le motif" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#d9ead3;strokeColor=#6aa84f;strokeWidth=3;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="950" width="260" height="64" as="geometry"/></mxCell><mxCell id="esc" value="&lt;b&gt;ESCALADE HUMAINE MOTIVÉE&lt;/b&gt;&lt;br&gt;motif · étape atteinte · données disponibles · tentatives faites" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="700" y="940" width="340" height="84" as="geometry"/></mxCell><mxCell id="bornes" value="&lt;b&gt;Bornes provisoires&lt;/b&gt;&lt;br&gt;vérifiées par l&#x27;orchestrateur avant chaque délégation&lt;br&gt;&lt;br&gt;• Étapes par demande : 10 au plus&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(le chemin le plus long prévu en compte 7)&lt;br&gt;• Appels par agent : 2 au plus&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(1 essai, puis 1 relance si exception, sortie invalide ou délai dépassé)&lt;br&gt;• Même état vu deux fois : arrêt immédiat&lt;br&gt;• Délai global par demande : 120 s&lt;br&gt;• Budget LLM par demande : fixé après mesure du cas nominal&lt;br&gt;&lt;br&gt;&lt;i&gt;Valeurs de départ. Le plan d&#x27;épreuve du chantier 2 les confirme ou les ajuste ; chaque changement entre au journal des ajustements.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;rounded=1;fillColor=#fce5cd;strokeColor=#e69138;strokeWidth=2;fillColor=#fff2cc;strokeColor=#bf9000;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1080" y="100" width="400" height="240" as="geometry"/></mxCell><mxCell id="a1" value="délègue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="e"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="168"/><mxPoint x="185" y="168"/></Array></mxGeometry></mxCell><mxCell id="a2" value="délègue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#2E6B3E;strokeWidth=1.2;fontColor=#2E6B3E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="p"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="168"/><mxPoint x="475" y="168"/></Array></mxGeometry></mxCell><mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="305"/><mxPoint x="330" y="305"/></Array></mxGeometry></mxCell><mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="305"/><mxPoint x="330" y="305"/></Array></mxGeometry></mxCell><mxCell id="a5" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="est"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a6" value="oui : arrêt anticipé" style="edgeStyle=o